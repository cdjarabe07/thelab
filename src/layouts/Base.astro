---
// Polices servies par le site lui-même : aucune requête vers un service tiers.
import '@fontsource/rubik/300.css';
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/noticia-text/400.css';
import '@fontsource/noticia-text/400-italic.css';
import '@fontsource/noticia-text/700.css';
import '../styles/global.css';
import { NAV, LINKS, SITE } from '../data/lab';
import { assertIntegrity, formatDate } from '../lib';

await assertIntegrity();

interface Props {
  title?: string;
  description?: string;
  page?: string;
  type?: 'website' | 'article';
  jsonld?: Record<string, unknown>;
  noindex?: boolean;
  /** Page indexée par la recherche interne (fiches, notes, domaines, About). Les listes ne le sont pas. */
  searchable?: boolean;
}
const { title, description = SITE.description, page = '', type = 'website', jsonld, noindex = false, searchable = false } = Astro.props;
const fullTitle = title ? `${title} · TheLab` : `TheLab · ${SITE.author}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const built = formatDate(new Date());

const person = {
  '@type': 'Person', name: SITE.author, url: new URL('/about/', Astro.site).href,
  sameAs: [LINKS.github, LINKS.linkedin], jobTitle: 'Data scientist', address: { '@type': 'PostalAddress', addressLocality: 'Dakar', addressCountry: 'SN' },
};
const ld = jsonld ?? { '@context': 'https://schema.org', '@type': 'WebSite', name: 'TheLab', url: Astro.site?.href, author: person, inLanguage: 'fr' };
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  {noindex && <meta name="robots" content="noindex">}
  <meta property="og:site_name" content="TheLab">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={type}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:locale" content="fr_FR">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="TheLab · Notes" href="/notes/rss.xml">
  <link rel="sitemap" href="/sitemap-index.xml">
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <div class="frame">
    <header class:list={['site-header', { 'with-mark': page !== 'home' }]}>
      <a class="wordmark" href="/"><span class="tl">TheLab</span> <span class="muted">— {SITE.author}</span></a>
      <nav class="nav" aria-label="Navigation principale">
        <a href="/recherche/" aria-label="Rechercher (raccourci : /)" class:list={['search', { active: page === 'search' }]}>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="10" cy="10" r="7"/><path d="M15 15l6 6"/></svg>
        </a>
        {NAV.map(([k, href, label]) => (
          <a href={href} class:list={{ active: k === page, tl: k === 'home' }} aria-current={k === page ? 'page' : undefined}>{label}</a>
        ))}
        <button class="nav-toggle" aria-expanded="false">Menu</button>
      </nav>
    </header>
  </div>

  <div id="contenu" data-pagefind-body={searchable ? '' : undefined}><slot /></div>

  <div class="frame">
    <footer class="site-footer">
      <div>
        <div class="brand tl">TheLab</div>
        <p class="muted" style="margin:12px 0 0">Le laboratoire de {SITE.author} · data &amp; IA</p>
        <p class="muted" style="margin:4px 0 0">Mis à jour le {built}</p>
      </div>
      <div><div class="label">Le lab</div><ul>
        {NAV.slice(1).map(([, href, label]) => <li><a href={href}>{label}</a></li>)}
        <li><a href="/roadmap/">Roadmap</a></li>
        <li><a href="/domaines/">Domaines</a></li>
      </ul></div>
      <div><div class="label">Ailleurs</div><ul>
        <li><a href={LINKS.github}>GitHub ↗</a></li>
        <li><a href={LINKS.linkedin}>LinkedIn ↗</a></li>
        <li><a href="/notes/rss.xml">Flux RSS des notes</a></li>
      </ul></div>
    </footer>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.nav-toggle').forEach((btn) =>
      btn.addEventListener('click', () => {
        const open = btn.closest('.nav')!.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(open));
      }));
    // Sommaire collant : surligne la section visible
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc ol a')];
    if (links.length && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id));
      }), { rootMargin: '0px 0px -70% 0px' });
      links.forEach((a) => { const s = document.getElementById(decodeURIComponent(a.hash.slice(1))); if (s) io.observe(s); });
    }
    // « / » ouvre la recherche
    document.addEventListener('keydown', (e) => {
      const t = e.target as HTMLElement;
      if (e.key === '/' && !/INPUT|TEXTAREA/.test(t.tagName) && !location.pathname.startsWith('/recherche')) {
        e.preventDefault(); location.href = '/recherche/';
      }
    });
  </script>
</body>
</html>
